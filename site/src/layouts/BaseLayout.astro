---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const base = import.meta.env.BASE_URL;
const normalizedBase = base.endsWith('/') ? base : `${base}/`;
const site = Astro.site ?? new URL('https://grr-cli.pages.dev');
const relativePath = Astro.url.pathname.startsWith(normalizedBase)
  ? Astro.url.pathname.slice(normalizedBase.length)
  : Astro.url.pathname.replace(/^\/+/, '');
const canonical = new URL(`${normalizedBase}${relativePath}`, site).toString();
const socialImage = new URL(`${normalizedBase}og.svg`, site).toString();
const fullTitle = title === 'grr' ? 'Rust Rewrite (grr) — Google tools from the terminal' : `${title} · Rust Rewrite (grr)`;
const jsonLd = JSON.stringify({
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'Rust Rewrite',
  alternateName: 'grr',
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'macOS, Linux, Windows',
  license: 'MIT',
  codeRepository: 'https://github.com/debanjanbasu/grr-cli',
  description,
  offers: {
    '@type': 'Offer',
    price: 0,
    priceCurrency: 'USD',
  },
});
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <script is:inline>
      (function () {
        try {
          var theme = localStorage.getItem('grr-theme');
          if (theme === 'light' || theme === 'dark') {
            document.documentElement.setAttribute('data-theme', theme);
          }
        } catch (error) {
          /* storage unavailable: stay on the system theme */
        }
      })();
    </script>
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="author" content="grr project" />
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#fbf7f1" />
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#1b130e" />
    <meta name="color-scheme" content="light dark" />
    <meta name="google-site-verification" content="eOuATr6yw8ALdCuyHxA_fan3dXicCibqOyHg1ZORrYo" />
    <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
    <link rel="preload" href={`${normalizedBase}fonts/3270-Regular.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href={`${normalizedBase}favicon.svg`} sizes="any" />
    <link rel="icon" type="image/svg+xml" href={`${normalizedBase}favicon-32.svg`} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={`${normalizedBase}favicon-16.svg`} sizes="16x16" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Rust Rewrite" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:type" content="image/svg+xml" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="grr pixel-art crab mascot and terminal command" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <meta name="twitter:image:alt" content="grr pixel-art crab mascot and terminal command" />
    <script type="application/ld+json" set:html={jsonLd}></script>
    <title>{fullTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="backdrop" aria-hidden="true"><span class="backdrop-stars-back"></span><span class="backdrop-stars-mid"></span></div>
    <div class="scroll-progress" aria-hidden="true"></div>
    <div class="site-shell">
      <Header />
      <main id="main-content">
        <slot />
      </main>
      <Footer />
    </div>
    <script is:inline type="module">
      (function () {
        var root = document.documentElement;
        var button = document.querySelector('[data-theme-toggle]');
        var query = window.matchMedia('(prefers-color-scheme: dark)');
        var isDark = function () {
          return root.dataset.theme === 'dark' || (query.matches && root.dataset.theme !== 'light');
        };
        var sync = function () {
          if (!button) return;
          button.setAttribute('aria-pressed', String(isDark()));
        };
        if (button) {
          button.addEventListener('click', function () {
            var next = isDark() ? 'light' : 'dark';
            root.dataset.theme = next;
            try {
              localStorage.setItem('grr-theme', next);
            } catch (error) {
              /* storage unavailable: toggle for this visit only */
            }
            sync();
          });
        }
        if (query.addEventListener) {
          query.addEventListener('change', sync);
        }
        sync();
      })();
    </script>
  </body>
</html>
